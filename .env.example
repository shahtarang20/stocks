# ============================================================================
# ComputeCoin — environment template.  Copy to `.env` and fill in.
# NEVER commit real secrets. Use a secrets manager in staging/production.
# ============================================================================

# ---- Runtime ----
ENVIRONMENT=development                 # development | staging | production
LOG_LEVEL=info                          # debug | info | warning | error

# ---- URLs ----
FRONTEND_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ---- Database (Postgres) ----
# Local dev (docker-compose):
DATABASE_URL=postgresql+asyncpg://computecoin:computecoin@localhost:5432/computecoin
# Hosted (Supabase free tier) example — use the "Connection string" (async driver):
# DATABASE_URL=postgresql+asyncpg://postgres:<password>@db.<ref>.supabase.co:5432/postgres

# ---- Redis (cache, rate limiting, leases) ----
REDIS_URL=redis://localhost:6379/0

# ---- Auth / crypto secrets (generate strong random values!) ----
# e.g.  openssl rand -hex 32
AUTH_SECRET=change-me-to-a-long-random-hex-string
SESSION_SECRET=change-me-to-another-long-random-hex-string
ACCESS_TOKEN_TTL_SECONDS=900            # 15 minutes
REFRESH_TOKEN_TTL_SECONDS=1209600       # 14 days

# ---- Object storage (S3-compatible: MinIO local, Supabase Storage hosted) ----
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=computecoin-artifacts
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin
OBJECT_STORAGE_REGION=us-east-1

# ---- Email (dev: tokens are logged, not sent) ----
EMAIL_PROVIDER=console                  # console (logs only) | smtp | resend
EMAIL_FROM=ComputeCoin <noreply@your-domain.example>
# SMTP (EMAIL_PROVIDER=smtp). In production use a real provider: with 'console',
# verification and password-reset emails are only logged and users cannot finish signup.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true
RESEND_API_KEY=                         # only for EMAIL_PROVIDER=resend

# ---- Payments (MVP: simulated / test credits only) ----
PAYMENT_PROVIDER_CONFIGURATION=simulated

# ---- Rate limiting ----
# Set true in production so rate limits are shared across API instances.
RATE_LIMIT_REQUIRE_REDIS=false

# ---- Production (ENVIRONMENT=production) ----
# The API refuses to start with dev secrets. Token/chain settlement is off the
# launch path: either keep it disabled, or set a real signer key.
SETTLEMENT_ENABLED=false
# PLATFORM_SIGNER_PRIVATE_KEY=              # required only if SETTLEMENT_ENABLED=true

# ---- Provider agent enrollment ----
PROVIDER_AGENT_ENROLLMENT_CONFIGURATION=dev

# ---- Proof-of-Privacy (ADR-0005) ----
# Off by default outside development: private tiers are refused. Turning it on in production
# requires real keys (the API refuses to boot otherwise).
PRIVACY_ENABLED=false
# Ed25519 seed (64 hex). Its public key is published at GET /v1/privacy/verifier-key.
# PRIVACY_VERIFIER_SIGNING_KEY=<64 hex>
# Guardians whose X25519 private key lives in THIS process; must be FEWER than the threshold.
# PRIVACY_GUARDIAN_PRIVATE_KEYS={"computecoin":"<64 hex>"}
# Every guardian's public key, including external ones (partner, customer).
# PRIVACY_GUARDIAN_PUBLIC_KEYS={"computecoin":"<64 hex>","partner":"<64 hex>"}
PRIVACY_GUARDIAN_THRESHOLD=2
# Development/tests ONLY: issue verdicts from software attestation. Refused in production.
PRIVACY_SOFTWARE_ATTESTATION=false
