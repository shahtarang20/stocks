# Base URL for the ComputeCoin FastAPI backend.
# Defaults to http://localhost:8000 if unset (see src/lib/api.ts).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# EXPERIMENTAL. Where the Windows agent installer (an .msi) can be downloaded, and its SHA-256 (64 hex characters). While either is unset the host setup
# page's Windows option says the installer is not published yet and shows nothing to copy. The address must be https and end in .msi.
# NEXT_PUBLIC_WINDOWS_AGENT_MSI_URL=
# NEXT_PUBLIC_WINDOWS_AGENT_MSI_SHA256=
