# ==============================================================================
# ComputeCoin Testnet Deployment Configuration
# Copy this file to .env:  cp .env.example .env
# ==============================================================================
# ⚠️ NEVER commit your real private key. This file is git-ignored.
# ⚠️ Only use a testnet wallet with test tokens (Sepolia / Base Sepolia / BSC Testnet).

# Your testnet wallet private key (from MetaMask: Account Details -> Show Private Key)
# Format: 64-character hex string (with or without 0x prefix)
DEPLOYER_PRIVATE_KEY=

# Initial owner receiving the 1,000,000,000 COMPUTE supply.
# Defaults to DEPLOYER_PRIVATE_KEY address if left empty.
INITIAL_OWNER=

# RPC Endpoints (optional; defaults to reliable public endpoints if empty)
SEPOLIA_RPC_URL=https://rpc.sepolia.org
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BSC_TESTNET_RPC_URL=https://data-seed-prebsc-1-s1.binance.org:8545

# Block Explorer API Keys (for automated source code verification on Etherscan/Basescan)
ETHERSCAN_API_KEY=
BASESCAN_API_KEY=
BSCSCAN_API_KEY=

# Liquidity pool: configured in launch/pool*.json and run with scripts/pool.mjs (see docs/operations/launch-checklist.md).

# ==============================================================================
# Workstream D: ComputeSettlement & Protocol Roles
# ==============================================================================
# Multisig Safe owner (e.g. 0x... from app.safe.global on Sepolia)
# If provided, deployment scripts automatically transfer contract ownership to this Safe
MULTISIG_OWNER=

# Platform execution voucher signer public key (defaults to deployer if empty)
PLATFORM_SIGNER_ADDRESS=

# Platform voucher signer private key (used by backend & E2E lifecycle test)
# Dev fallback: 0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d
PLATFORM_SIGNER_PRIVATE_KEY=

# Protocol fee treasury address receiving platform fees (defaults to deployer if empty)
PLATFORM_TREASURY_ADDRESS=

# Existing contract addresses (optional; specify to reuse already deployed instances)
TOKEN_ADDRESS=
SETTLEMENT_CONTRACT_ADDRESS=

