{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "iterations": {
      "type": "integer",
      "minimum": 1000,
      "maximum": 60000,
      "default": 7000
    },
    "run_colmap": {
      "type": "boolean",
      "default": true
    },
    "colmap_matcher": {
      "type": "string",
      "enum": [
        "exhaustive",
        "sequential"
      ],
      "default": "exhaustive"
    },
    "sh_degree": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3,
      "default": 3
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295,
      "default": 0
    }
  }
}
