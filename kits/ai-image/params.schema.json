{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["prompts"],
  "properties": {
    "prompts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {"type": "string", "minLength": 1, "maxLength": 1000}
    },
    "seed": {"type": "integer", "minimum": 0, "maximum": 4294967295, "default": 0},
    "width": {"type": "integer", "minimum": 256, "maximum": 1536, "multipleOf": 16, "default": 1024},
    "height": {"type": "integer", "minimum": 256, "maximum": 1536, "multipleOf": 16, "default": 1024},
    "steps": {"type": "integer", "minimum": 1, "maximum": 8, "default": 4}
  }
}
