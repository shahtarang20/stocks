{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "prompts"
  ],
  "properties": {
    "prompts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      }
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295,
      "default": 0
    },
    "width": {
      "type": "integer",
      "minimum": 256,
      "maximum": 720,
      "multipleOf": 16,
      "default": 720
    },
    "height": {
      "type": "integer",
      "minimum": 256,
      "maximum": 480,
      "multipleOf": 16,
      "default": 480
    },
    "num_frames": {
      "type": "integer",
      "enum": [
        9,
        17,
        25,
        33,
        41,
        49
      ],
      "default": 49
    },
    "steps": {
      "type": "integer",
      "minimum": 10,
      "maximum": 50,
      "default": 50
    },
    "guidance_scale": {
      "type": "number",
      "minimum": 1,
      "maximum": 12,
      "default": 6
    },
    "fps": {
      "type": "integer",
      "minimum": 6,
      "maximum": 30,
      "default": 8
    },
    "crf": {
      "type": "integer",
      "minimum": 14,
      "maximum": 28,
      "default": 18
    }
  }
}
