{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "max_length": {
      "type": "integer",
      "minimum": 16,
      "maximum": 8192,
      "default": 512
    },
    "batch_size": {
      "type": "integer",
      "minimum": 1,
      "maximum": 256,
      "default": 32
    },
    "normalize": {
      "type": "boolean",
      "default": true
    },
    "round_decimals": {
      "type": "integer",
      "minimum": 2,
      "maximum": 8,
      "default": 4
    },
    "pooling": {
      "type": "string",
      "enum": [
        "mean",
        "cls"
      ],
      "default": "mean"
    }
  }
}
