{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["frame_start", "frame_end"],
  "properties": {
    "frame_start": {"type": "integer", "minimum": 0, "maximum": 1048574},
    "frame_end": {"type": "integer", "minimum": 0, "maximum": 1048574},
    "frame_step": {"type": "integer", "minimum": 1, "maximum": 1000, "default": 1},
    "engine": {"type": "string", "enum": ["CYCLES", "EEVEE"], "default": "CYCLES"},
    "device": {"type": "string", "enum": ["AUTO", "CPU", "CUDA", "OPTIX", "HIP"], "default": "AUTO"},
    "samples": {"type": "integer", "minimum": 1, "maximum": 8192, "default": 128},
    "resolution_percent": {"type": "integer", "minimum": 10, "maximum": 200, "default": 100},
    "seed": {"type": "integer", "minimum": 0, "maximum": 2147483647, "default": 0},
    "denoise": {"type": "boolean", "default": false},
    "format": {"type": "string", "enum": ["PNG"], "default": "PNG"}
  }
}
