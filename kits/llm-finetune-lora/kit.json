{
  "schema": 1,
  "slug": "llm-finetune-lora",
  "version": "1.0.0",
  "name": "LLM fine-tuning (LoRA)",
  "description": "Trains a LoRA adapter on one baked base model from a JSONL dataset with peft and PyTorch. Runs on one GPU, or on several GPUs of one host (and several nodes when U13 multi-node is enabled) through torchrun. Licences: see kits/llm-finetune-lora/README.md.",
  "category": "training",
  "image": "ghcr.io/computecoin/kit-llm-finetune-lora@sha256:PENDING",
  "mode": "batch",
  "param_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "epochs": {
        "type": "integer",
        "minimum": 1,
        "maximum": 20,
        "default": 1
      },
      "learning_rate": {
        "type": "number",
        "minimum": 1e-06,
        "maximum": 0.01,
        "default": 0.0002
      },
      "lora_r": {
        "type": "integer",
        "enum": [
          8,
          16,
          32,
          64
        ],
        "default": 16
      },
      "lora_alpha": {
        "type": "integer",
        "minimum": 1,
        "maximum": 256,
        "default": 32
      },
      "lora_dropout": {
        "type": "number",
        "minimum": 0,
        "maximum": 0.5,
        "default": 0.05
      },
      "max_seq_len": {
        "type": "integer",
        "minimum": 128,
        "maximum": 8192,
        "default": 1024
      },
      "micro_batch_size": {
        "type": "integer",
        "minimum": 1,
        "maximum": 64,
        "default": 1
      },
      "global_batch_size": {
        "type": "integer",
        "minimum": 1,
        "maximum": 1024,
        "default": 16
      },
      "seed": {
        "type": "integer",
        "minimum": 0,
        "maximum": 4294967295,
        "default": 0
      }
    }
  },
  "inputs": [
    {
      "name": "dataset",
      "kind": "file",
      "required": true
    }
  ],
  "outputs": [
    {
      "name": "adapter",
      "path": "/out/adapter"
    },
    {
      "name": "metrics",
      "path": "/out/metrics.json"
    }
  ],
  "resource_defaults": {
    "gpu_count": 1,
    "min_vram_gb": 24,
    "min_compute_capability": "8.0",
    "cpu": 8,
    "ram_gb": 64,
    "disk_gb": 100
  },
  "billing_hints": {
    "unit": "training_example",
    "est_gpu_seconds_per_unit": null
  },
  "verification": {
    "method": "loss_curve",
    "sample_fraction": 0.0,
    "min_samples": 1,
    "thresholds": {"max_rel_diff": 0.25},
    "owner_decision": "OWNER DECISION: the final training loss in metrics.json must be within max_rel_diff (0.25 relative, conservative default, to be tuned with benchmark data U5.3) of an independent re-run; non-finite loss fails. Adapter weights are not compared. sample_fraction stays 0.0 (redundancy off) until the owner decides to enable it."
  }
}
