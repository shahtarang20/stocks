#!/bin/sh
# Runs inside the image build chroot. Everything here must be deterministic.
set -eu

# Agent: installed from the wheelhouse that scripts/build.sh placed under /opt/computecoin-agent,
# hash-pinned and offline (no index access).
python3 -m venv /opt/computecoin-agent/venv
/opt/computecoin-agent/venv/bin/pip install --no-index --no-deps --require-hashes \
    --find-links /opt/computecoin-agent/wheels -r /opt/computecoin-agent/requirements.lock
rm -rf /opt/computecoin-agent/wheels

# No interactive access: lock root, remove login shells' ability to be used, mask consoles.
passwd -l root || true
usermod -s /usr/sbin/nologin root || true
systemctl mask getty.target serial-getty@.service console-getty.service getty@.service \
    ssh.service ssh.socket sshd.service systemd-logind.service || true
rm -f /etc/ssh/sshd_config /usr/sbin/sshd /usr/bin/su || true

systemctl enable docker.service computecoin-agent.service computecoin-pcr-report.service systemd-resolved.service systemd-timesyncd.service

# Machine id and random seed must be per boot, never part of the measured image.
: > /etc/machine-id
rm -f /var/lib/systemd/random-seed

# Reproducibility: drop files that embed build-time state.
rm -rf /var/log/* /var/cache/ldconfig/aux-cache /var/lib/dpkg/lock* /tmp/*
